<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D1B2A"
    android:padding="32dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GUNBOUND"
        android:textColor="#FFD700"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GUIA DE MIRA"
        android:textColor="#00FF88"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toque para ativar o overlay."
        android:textColor="#AAAAAA"
        android:textSize="15sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- Botão principal -->
    <Button
        android:id="@+id/btnStartOverlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="INICIAR OVERLAY"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="#00FF88"
        android:layout_marginBottom="16dp"/>

    <!-- Botão permissão (só aparece se necessário) -->
    <Button
        android:id="@+id/btnPermission"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="ATIVAR PERMISSAO DE OVERLAY"
        android:textColor="#000000"
        android:textSize="13sp"
        android:background="#FFD700"
        android:visibility="gone"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Como usar:\n1. Toque em INICIAR OVERLAY\n2. Abra o Gunbound\n3. O guia aparece por cima do jogo\n4. Arraste pelo cabecalho para mover"
        android:textColor="#666666"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:lineSpacingMultiplier="1.5"/>

</LinearLayout>
